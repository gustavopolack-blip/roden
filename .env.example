# IA — OPENAI / CHATGPT (server-side only)
# API key from https://platform.openai.com/api-keys (a ChatGPT Plus subscription does NOT include it;
# the API is billed separately, per use).
# NO VITE_ PREFIX: read only by the serverless function api/ai.ts (process.env.OPENAI_*).
# With VITE_ it would be embedded in the public bundle.
# In production they live in Vercel → Project Settings → Environment Variables.
# OPENAI_MODEL: the model id exactly as OpenAI's docs list it (platform.openai.com/docs/models).
# Locally they are only used when running the api/ functions (e.g. `vercel dev`);
# plain `npm run dev` does not serve /api/ai.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=YOUR_OPENAI_MODEL_ID_HERE

# AVISO DE ERRORES (opcional): DSN del proyecto de Sentry (Settings → Client Keys).
# Es público por diseño (solo permite enviar errores). Sin esta variable, Sentry no se carga.
# En producción va en Vercel → Environment Variables (Production y Preview).
VITE_SENTRY_DSN=

# IMPORTANT NOTES:
# - Only browser-side variables use the VITE_ prefix (Supabase URL + anon key).
#   Never put a secret behind VITE_: everything with that prefix ends up in the bundle.
# - DO NOT commit the actual .env file to git (it's in .gitignore)
# - In Vercel, add these variables in: Project Settings → Environment Variables
